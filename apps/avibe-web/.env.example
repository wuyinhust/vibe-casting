# Local demo works without credentials. Never enable demo on a public deployment.
AVIBE_MODE=demo
APP_ORIGIN=http://localhost:3217
# Live mode requires a dedicated Supabase project and a direct/session PostgreSQL URL.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_ASSET_BUCKET=avibe-private
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Charging is disabled until operators configure active plans and prices.
PAYMENTS_ENABLED=false
WECHAT_APP_ID=
WECHAT_MERCHANT_ID=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY=
WECHAT_PLATFORM_PUBLIC_KEY=
WECHAT_PLATFORM_SERIAL=
WECHAT_API_V3_KEY=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# Promote staff using scripts/promote.ts after their first email login.
# Optional local demo directories (use internal storage for faster local I/O):
# AVIBE_DATA_DIR=/absolute/path/to/avibe-demo-db
# AVIBE_ASSET_DIR=/absolute/path/to/avibe-demo-assets
