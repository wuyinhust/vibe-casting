{
  "name": "avibe-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3217",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3217",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "worker": "node --import tsx worker/index.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "seed": "node --import tsx scripts/seed.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write app src worker scripts tests supabase docs",
    "import:character": "node --import tsx scripts/import-character.ts",
    "staff:promote": "node --import tsx scripts/promote.ts",
    "search:reindex": "node --import tsx scripts/reindex.ts",
    "import:leads": "node --env-file-if-exists=.env.local --import tsx scripts/import-leads.ts"
  },
  "dependencies": {
    "next": "^15.5.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@supabase/supabase-js": "^2.57.0",
    "@electric-sql/pglite": "^0.3.14",
    "pg": "^8.16.3",
    "pg-boss": "^12.0.0",
    "openai": "^6.0.0",
    "zod": "^4.1.0",
    "lucide-react": "^0.468.0",
    "sharp": "^0.35.5",
    "fflate": "^0.8.2",
    "server-only": "^0.0.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "@playwright/test": "^1.55.0",
    "@types/qrcode": "^1.5.5",
    "prettier": "^3.6.2"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    }
  },
  "type": "module"
}
